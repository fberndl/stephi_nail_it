# Copy to .env.local and fill in.
# Supabase values: dashboard -> Project Settings -> API (project "stephi-nail-it").

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated allow-list of admin emails (these may sign in to /admin).
# e.g. ADMIN_EMAIL=owner@example.com,studio@example.com
ADMIN_EMAIL=owner@example.com

# Needed for the contact form to email inquiries to the studio.
# Get a free key at https://web3forms.com (enter the studio's email address).
# If empty, the form falls back to opening the visitor's mail app.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Public site URL. Drives the Supabase magic-link redirect AND all SEO URLs
# (canonical tags, sitemap.xml, robots.txt, OpenGraph/Twitter image links,
# JSON-LD). In production set this to the real domain, e.g.
# https://stephi-nail-it.vercel.app or a custom domain. localhost is ignored
# for SEO so a forgotten value can't leak into production metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: paste the token from Google Search Console (HTML-tag verification
# method) to verify domain ownership. Leave empty until you have it.
GOOGLE_SITE_VERIFICATION=
